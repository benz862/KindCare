# Browser-safe app settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production is hosted on Vercel at https://kindcare.app
# In Supabase Auth settings, set Site URL to this value and add
# {NEXT_PUBLIC_APP_URL}/auth/callback to Redirect URLs.

# KindCare Supabase (project urattpxyetpfonbrnltj)
NEXT_PUBLIC_SUPABASE_URL=https://urattpxyetpfonbrnltj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# KindCare mailboxes are on iCloud (support@, info@, and billing@kindcare.app).
# Do not configure Resend. App-sent mail is not used in this phase.

# Server-only billing. Do not set until pricing and the SkillBinder Stripe account are ready.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

LOG_LEVEL=info
